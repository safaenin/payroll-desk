rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Owner and explicitly authorized admins share this workspace.
    // Add admin Firebase UIDs to this list AND VITE_ADMIN_UIDS in the app.
    function owner(uid) {
      return request.auth != null
        && uid == 'oazDtOGd96ecNL255rXvm3IYkaK2'
        && request.auth.uid in ['oazDtOGd96ecNL255rXvm3IYkaK2'];
    }
    function deletingEmployee(uid) {
      return get(/databases/$(database)/documents/owners/$(uid)/meta/revision)
        .data.keys().hasAll(['employeeDeletion']);
    }
    match /owners/{uid}/{group}/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && group in [
          'employees',
          'attendance',
          'adjustments',
          'runs',
          'payments',
          'files',
          'imports',
          'settings',
          'meta',
          'advances',
          'fileDeletions',
          'businessBrands',
          'businessRegistrations',
          'businessExpenses',
          'businessRecurrences'
        ];
      allow update: if owner(uid)
        && group in [
          'employees',
          'attendance',
          'adjustments',
          'settings',
          'meta',
          'businessBrands',
          'businessRegistrations',
          'businessExpenses',
          'businessRecurrences'
        ];
      allow update: if owner(uid) && group == 'advances'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schedule']);
      // Payment facts remain immutable; a correction can only add a void audit.
      allow update: if owner(uid) && group == 'payments'
        && !resource.data.keys().hasAny(['voidedAt', 'voidReason'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voidedAt', 'voidReason'])
        && request.resource.data.voidedAt is string
        && request.resource.data.voidedAt.size() > 0
        && request.resource.data.voidReason is string
        && request.resource.data.voidReason.size() > 0;
      allow delete: if false;
      allow delete: if owner(uid) && group == 'businessExpenses'
        && resource.data.keys().hasAll(['deletion'])
        && resource.data.deletion.remainingFileIds.size() == 0;
      // Cascade cleanup is allowed only during an owner-started deletion job.
      allow delete: if owner(uid) && deletingEmployee(uid)
        && group in [
          'employees',
          'attendance',
          'adjustments',
          'payments',
          'advances',
          'files',
          'fileDeletions'
        ];
      allow update: if owner(uid) && deletingEmployee(uid)
        && (
          (group == 'runs'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lines']))
          || (group == 'imports'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revisions']))
        );
      allow update: if owner(uid) && group == 'fileDeletions'
        && resource.data.status == 'pending'
        && request.resource.data.status == 'trashed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt']);
    }
  }
}
